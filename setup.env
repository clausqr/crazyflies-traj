# crazyflies-traj rr settings. Sourced by every scripts/*.bash (./rr <script>).
#
# LEAN client image: ros-base + crazyflie_interfaces + the mocap message
# package. No cffirmware, no simulator, no Crazyswarm2 server, no USB, no
# mocap client. This repo only ever runs a DDS client of the lab
# plant (traj_player) and its offline tests.

# Container user = host user (rootful Docker), so the bind-mounted ros2_ws stays
# writable and files created inside come back owned by you. 
RR_USER_GID=$(id -g $(whoami))
RR_USER_UID=$(id -u)
RR_USERNAME=user

# Image name and tag. build.bash tags :$RR_IMAGE_TAG and :latest.
RR_IMAGE_NAME=crazyflies-traj
RR_IMAGE_TAG="${RR_IMAGE_TAG:-v0.2.0}"

RR_ROS_DISTRO=jazzy

# ROS 2 domain. 66 is the lab fleet domain (the lab plant runs on 66).
# MUST be 0-232 (DDS port 7400 + 250 * id overflows above 232).
# Override per run for anything that is NOT a lab flight, e.g. the offline
# rehearsal: `RR_ROS_DOMAIN_ID=133 ./rr rehearse`. scripts/rehearse.bash
# REFUSES 0 (the ROS default, which other ROS 2 setups on the same network may share)
# and 66 (the lab plant): a rehearsal must never see a real graph.
RR_ROS_DOMAIN_ID="${RR_ROS_DOMAIN_ID:-66}"

# ---------------------------------------------------------------------------
# DDS transport containment: the profiles live in dds/ (RR_DDS_DIR), owned by
# this repo. loopback: dds/*_loopback.xml (committed). lan: dds/*_client.xml,
# downloaded from the groundstation (RR_DDS_URL) with __OWN_IP__ replaced by
# this machine's IP (README, "DDS profiles"). run.bash bind-mounts the directory
# read-only at /ros2_ws/config and refuses to start when the profile file is
# missing or still holds __OWN_IP__ (no silent fallback to an uncontained DDS
# on --net=host).
RR_DDS_DIR="${RR_DDS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dds}"
# Site-specific values (groundstation URL and login) live in rr.local next to this
# file: git-ignored, never committed (copy rr.local.example).
[ -f "$(dirname "${BASH_SOURCE[0]}")/rr.local" ] && . "$(dirname "${BASH_SOURCE[0]}")/rr.local"
RR_DDS_URL="${RR_DDS_URL:-http://GROUNDSTATION/dds}"
RR_DDS_LOGIN="${RR_DDS_LOGIN:-USER:PASSWORD}"

# lan (DEFAULT): join the groundstation's domain over the rig LAN (a lab flight;
# `./rr run` drops you into a shell on the plant's graph).
# loopback: single box, all RTPS on 127.0.0.1 (rehearsal / dev); `./rr rehearse`
# selects it itself.
RR_NET_MODE="${RR_NET_MODE:-lan}"

# Kept 0 on purpose (deprecated on Jazzy): the XML profile is the single
# source of containment; ROS_LOCALHOST_ONLY is deprecated on Jazzy.
RR_ROS_LOCALHOST_ONLY=0

# Vehicle namespace (the plant's vehicle roster).
RR_CF_NAME="${RR_CF_NAME:-cf1}"

# This image never touches USB (no Crazyradio, no cflib). run.bash REFUSES
# RR_USB_ENABLED=1 instead of ignoring it, so a copy-pasted plant command line
# cannot silently look like it worked.
RR_USB_ENABLED="${RR_USB_ENABLED:-0}"

# Trajectory directory, bind-mounted READ-ONLY at /traj.
RR_TRAJ_DIR="${RR_TRAJ_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/trajectories}"

# Extra docker volumes (comma-separated host:container[:opts]) and env
# (comma-separated KEY=VALUE). USER is set because the
# container runs under a numeric --user.
RR_VOLUMES="${RR_VOLUMES-}"
RR_ENV="USER=${RR_USERNAME}"
